# Copy this file to .env (which is gitignored) and fill in values referenced
# from config/servers/*.yaml via ${VAR}. Any var you reference in YAML MUST
# be defined here (or in the shell env) — the loader throws if it's missing.
#
# ${VAR} works in ANY string field — host, user, key path, passphrase, etc.
# Use it to keep public IPs, credentials, and other host-identifying info out
# of git.

# --- Hosts you don't want in the repo (e.g. publicly-routable IPs) ---
HETZNER_HOST=

# --- SSH key passphrases ---
# HETZNER_PASSPHRASE=

# --- SSH passwords (only if you must use password auth) ---
# SOMEHOST_PASSWORD=

# --- API port override (optional) ---
# PORT=5781

# --- Auth (Discord OAuth) -------------------------------------------------
# The app gates all /api and /ws routes behind a Discord login. Create an app
# at https://discord.com/developers/applications, and under OAuth2 add BOTH
# redirect URLs:
#   http://localhost:5780/api/auth/callback        (local dev)
#   https://<your-domain>/api/auth/callback         (prod)
# Then copy the Client ID + Client Secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user ids allowed to sign in. Enable Developer Mode
# in Discord (Settings -> Advanced), right-click your name -> Copy User ID.
ALLOWED_DISCORD_IDS=

# Public base URL the app is reached at — used to build the OAuth callback and
# (in prod) to set Secure cookies. Local dev: http://localhost:5780
PUBLIC_URL=http://localhost:5780

# Session cookie crypto (stateless encrypted cookie — no server-side store).
# SESSION_SECRET must be >= 32 chars; SESSION_SALT must be EXACTLY 16 chars.
# Generate: openssl rand -hex 24  (secret)  /  openssl rand -hex 8  (salt)
SESSION_SECRET=
SESSION_SALT=

# --- ntfy push alerts (recurring jobs) ------------------------------------
# Jobs in config/jobs/*.yaml can `notify:` via ntfy. Optional: leave
# NTFY_TOPIC unset to disable alerting entirely (jobs still run, just silent).
# Install the ntfy app, subscribe to your topic, and set it here.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional bearer token for protected / self-hosted topics.
NTFY_TOKEN=

# Job env vars — injected into a job's runbooks via the `env:` block in
# config/jobs/*.yaml (values there reference these as ${VAR}). An unset var
# doesn't break the API: the job just errors on each run until you set it.
# OPTIONAL: vpn-check defaults its home-ISP match to "Vocus"; override here
# (and uncomment the env block in vpn-watchdog.yaml) to keep it out of git:
# VPN_HOME_ISP=Vocus

# --- Media cleanup (Radarr / Sonarr / Plex disk triage) --------------------
# Optional: powers the "media" view (config/media.yaml). Each var gates its
# service independently — unset ⇒ that service is skipped with a warning;
# both arr keys unset ⇒ the view is hidden entirely. The API always boots.
# Radarr/Sonarr: Settings -> General -> Security -> API Key.
# Plex: any X-Plex-Token (see support.plex.tv "finding an authentication token").
# RADARR_API_KEY=
# SONARR_API_KEY=
# PLEX_TOKEN=

# --- Azure OpenAI (built-in AI assistant) ---------------------------------
# Optional: powers AI features (runbook generation, live troubleshooting,
# alert investigation). Leave unset to disable — the API still runs, AI just
# no-ops and the UI hides its affordances (same clone-and-go stance as ntfy).
# We call the chat-completions REST endpoint directly (no SDK). Set the base
# endpoint ORIGIN only — the deployment path + api-version are added in code.
# AZURE_OPENAI_ENDPOINT=https://dylan-ml3fg2xi-eastus.cognitiveservices.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=home-mgr-io
# Deployment is o4-mini (a reasoning model): code sends max_completion_tokens
# and omits temperature accordingly. Override the api-version if yours differs.
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional reasoning depth: low | medium | high (omit for the model default).
# AZURE_OPENAI_REASONING_EFFORT=low
