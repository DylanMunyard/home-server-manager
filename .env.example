# Copy this file to .env (which is gitignored) and fill in values referenced
# from config/servers/*.yaml via ${VAR}. Any var you reference in YAML MUST
# be defined here (or in the shell env) — the loader throws if it's missing.
#
# ${VAR} works in ANY string field — host, user, key path, passphrase, etc.
# Use it to keep public IPs, credentials, and other host-identifying info out
# of git.

# --- Hosts you don't want in the repo (e.g. publicly-routable IPs) ---
HETZNER_HOST=

# --- SSH key passphrases ---
# HETZNER_PASSPHRASE=

# --- SSH passwords (only if you must use password auth) ---
# SOMEHOST_PASSWORD=

# --- API port override (optional) ---
# PORT=5781

# --- Auth (Discord OAuth) -------------------------------------------------
# The app gates all /api and /ws routes behind a Discord login. Create an app
# at https://discord.com/developers/applications, and under OAuth2 add BOTH
# redirect URLs:
#   http://localhost:5780/api/auth/callback        (local dev)
#   https://<your-domain>/api/auth/callback         (prod)
# Then copy the Client ID + Client Secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user ids allowed to sign in. Enable Developer Mode
# in Discord (Settings -> Advanced), right-click your name -> Copy User ID.
ALLOWED_DISCORD_IDS=

# Public base URL the app is reached at — used to build the OAuth callback and
# (in prod) to set Secure cookies. Local dev: http://localhost:5780
PUBLIC_URL=http://localhost:5780

# Session cookie crypto (stateless encrypted cookie — no server-side store).
# SESSION_SECRET must be >= 32 chars; SESSION_SALT must be EXACTLY 16 chars.
# Generate: openssl rand -hex 24  (secret)  /  openssl rand -hex 8  (salt)
SESSION_SECRET=
SESSION_SALT=
