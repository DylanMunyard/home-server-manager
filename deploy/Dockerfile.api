# Build stage
#
# Debian-based (glibc), NOT alpine: @fastify/secure-session depends on
# sodium-native, whose bundled prebuilds cover linux-x64 (glibc) but NOT
# linux-x64-musl. On alpine the native addon can't load and there's no
# toolchain to build it, so the API crash-loops with ADDON_NOT_FOUND. The
# glibc prebuild loads as-is here.
FROM node:20-slim AS build
WORKDIR /app
COPY api/package*.json ./
RUN npm ci
COPY api/tsconfig.json ./
COPY api/src ./src
RUN npm run build && npm prune --omit=dev

# Runtime stage
FROM node:20-slim AS runtime
WORKDIR /app
# node:20-slim already ships a `node` user/group at uid/gid 1000 — reuse it
# rather than creating one (a fresh useradd at 1000 collides). We only
# need its home dir, which the base image doesn't create.
RUN mkdir -p /home/app && chown node:node /home/app
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
# config/ is mounted at runtime via ConfigMaps; /home/app/.ssh via Secret.
# HOME must be set so os.homedir() returns /home/app — the YAML loader
# expands ~/.ssh/... against it.
USER node
ENV HOME=/home/app NODE_ENV=production PORT=5781
EXPOSE 5781
CMD ["node", "dist/server.js"]
